# Copie este arquivo para ".env" e preencha. O arquivo .env NÃO deve ir para o Git.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=socialnet
# Em produção (HTTPS) use 1. Em desenvolvimento local (http) deixe 0.
SESSION_COOKIE_SECURE=0
# 1 liga o modo debug do Flask (somente desenvolvimento)
FLASK_DEBUG=0
